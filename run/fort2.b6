*name FORTRAN
*     EDIT THE PROGRAM BELOW
      program eps
      real a, b
      double precision da, db
      dimension zz(2)
      equivalence (db,zz)
      a = 1.
      b = 0.
      da = 1.d0
      db = 0.d0
      i = 0
      print 9
   9  format(' single precision: all numbers are printed correctly')
  10  a=a/2.
      i=i+1
      b = 1.+a
      if(b.eq.1.) goto 20
      print 11,i,b,b
  11  format(' 1.0+2**-',i2,' =',f43.40,o17)
      goto 10
  20  i = 0
      print 29
  29  format(//' double precision: conversion fails at 1+2**-66'
     //'although numbers are distinct from 1 up to 1+2**-79')
  30  da=da/2.
      i=i+1
      db=1.d0+da
      if(db.eq.1.d0) goto 40
      print 31,i,db,zz(1),zz(2)
  31  format(' 1+2**-',i2,' = ',d77.70,2o17)
      goto 30
  40  stop
      end
*no load list
*execute
*end file

