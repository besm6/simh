#!/usr/bin/expect -f
#
# Сеанс оператора Диспака: смена, дата, время — и останов на сообщениях ЧП.
#
#   ./oper.exp                  дата и время берутся с хозяйской машины
#   ./oper.exp 2209 1200        дата ддмм и время ччмм явно
#
# Скрипт разговаривает с машиной ПО-НАСТОЯЩЕМУ: симулятор запускается на
# псевдотерминале, поэтому `sim_ttisatty()` истинно и набранное приходит
# через обычный ввод консоли (МПД.md §5). Команда SIMH `send` не нужна, и
# счёт команд ни при чём — каждая строка подаётся, КОГДА МАШИНА ОТВЕТИЛА на
# предыдущую.
#
# Порядок команд:
#
#   CME 1        смена 1        -> ` ECTЬ 1`
#   DAT ддмм     дата           -> ` ДATA:22.09.91 1`
#   TIM ччмм     время          -> ` ДATA:... BPEMЯ:12.00.00 1`
#
# ПОРЯДОК ВАЖЕН: на `TIM` раньше `DAT` машина отвечает ` ДAЙ ДAT 1`.
#
# Латинские буквы не случайны: в КОИ-7 совпадающие по начертанию буквы стоят
# на латинских позициях, так что `CME` на клавиатуре — это `СМЕ` (МПД.md §6).
#
# После `TIM` Диспак уходит с холостого хода, печатает несколько сообщений
# `ЧП(nnn) ... CБО,BBEДИ ПО ИHC` и ОСТАНАВЛИВАЕТСЯ САМ. Останов скрипт и
# ждёт: управление возвращается в `sim>`, причина печатается перед этим.
#
# Не дождавшись ответа, скрипт шлёт команду заново (TRIES раз): строка,
# дошедшая до машины покалеченной, разбору не поддаётся, и ответа на неё не
# будет. Замерено: 10 прогонов из 10 обходятся без повторов.
#
# Образцы для ожидания взяты ТОЛЬКО из латиницы КОИ-7 (`ECT`, `ATA:`,
# `BPEM`, `M=000`): это чистый ASCII, и совпадение не зависит от того, как
# канал разбирает UTF-8.

set DDMM    [lindex $argv 0]
set HHMM    [lindex $argv 1]
if {$DDMM eq ""} { set DDMM [clock format [clock seconds] -format "%d%m"] }
if {$HHMM eq ""} { set HHMM [clock format [clock seconds] -format "%H%M"] }

# Замерено: холостой ход на 2.7 с, останов на 3.3 с — весь сеанс около трёх
# с половиной секунд. Значения ниже — верхние границы, а не задержки.
set BOOT_TIMEOUT 10             ;# выход на холостой ход
set REPLY_TIMEOUT 3             ;# ответ на команду оператора (приходит сразу)
set TRIES 3                     ;# попыток на команду, см. «ПОЧЕМУ ПОВТОРЫ»
set STOP_TIMEOUT 10             ;# машина останавливается сама

cd [file dirname [info script]]

# --- рабочий образ диска и чистый барабан, как в boot.sh -------------------
# ОС пишет и на диск, и на барабан: повторный запуск на грязных файлах
# невоспроизводим.
set SRC $env(HOME)/git/besm6.github.io/download/disks/svs2053.bin
if {[info exists env(SVS2053)]} { set SRC $env(SVS2053) }
if {![file readable $SRC]} {
    puts stderr "oper.exp: не найден дистрибутивный образ: $SRC"
    puts stderr "oper.exp: укажите его через SVS2053=/путь/к/svs2053.bin"
    exit 2
}
if {![file executable ../BIN/svs]} {
    puts stderr "oper.exp: нет ../BIN/svs — соберите: (cd ../.. && make svs)"
    exit 2
}
exec python3 tools/makeSVS2053.py $SRC svs2053-fixed.bin
file delete drum5.bin
puts "oper.exp: образ svs2053-fixed.bin пересобран, барабан drum5.bin очищен"

# --- запуск ----------------------------------------------------------------
puts "oper.exp: дата $DDMM, время $HHMM"

set T0 [clock milliseconds]
proc elapsed {} { global T0; return [format "%.1f с" [expr {([clock milliseconds]-$T0)/1000.0}]] }

spawn ../BIN/svs int.ini
catch {fconfigure $spawn_id -encoding utf-8}

proc fail {why} {
    global spawn_id
    puts stderr "\noper.exp: ОШИБКА: $why"
    catch {exec kill -9 [exp_pid]}
    exit 1
}

# Строка `PEC:` — последняя в шапке; за ней Диспак встаёт на холостой ход.
set timeout $BOOT_TIMEOUT
expect {
    "PEC:"      { }
    timeout     { fail "машина не вышла на холостой ход за $BOOT_TIMEOUT с" }
    eof         { fail "симулятор завершился до выхода на холостой ход" }
}

puts "\noper.exp: холостой ход достигнут, [elapsed]"
set timeout $REPLY_TIMEOUT

# --- команды оператора -----------------------------------------------------
# Каждая подаётся после ответа на предыдущую; посланные подряд, они
# перемешиваются с ответами и до разбора не доходят.
#
# Ответа ждём ПОПЫТОК раз; не дождались — строка ушла покалеченной, шлём её
# заново. Ошибку разбирать не нужно: любой ответ, кроме ожидаемого, означает
# то же самое.
proc command {cmd good} {
    global spawn_id REPLY_TIMEOUT TRIES
    for {set i 1} {$i <= $TRIES} {incr i} {
        send "$cmd\r"
        set timeout $REPLY_TIMEOUT
        expect {
            -ex $good { return }
            timeout   { puts "\noper.exp: «$cmd» без ответа, повтор $i" }
            eof       { fail "симулятор завершился на «$cmd»" }
        }
    }
    fail "нет ответа «$good» на «$cmd» за $TRIES попыток"
}

command "CME 1"      "ECT"       ;# ECTЬ 1
command "DAT $DDMM"  "ATA:"      ;# ДATA:дд.мм.гг
command "TIM $HHMM"  "BPEM"      ;# BPEMЯ:чч.мм.сс

# --- ждём останова ---------------------------------------------------------
# Машина останавливается сама; `int.ini` на этом кончается, и SIMH выдаёт
# приглашение `sim>`. Причина останова печатается строкой перед ним и видна
# в выводе.
set timeout $STOP_TIMEOUT
expect {
    "sim>"  { puts "\noper.exp: машина остановилась, [elapsed]" }
    timeout { fail "машина не остановилась за $STOP_TIMEOUT с" }
    eof     { fail "симулятор завершился, не дойдя до останова" }
}

send "quit\r"
expect eof

puts "oper.exp: готово"
exit 0
