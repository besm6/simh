;
; Тест КАДОПАМ (команды 032/0132).
; Если все хорошо, бесконечно циклится на адресе 1017;
; ошибки останавливаются на 1040-1044.
;
в 1000
к уиа 2(1), счи 1               ; 1000: СМ := 2
к э32 70000, уиа 70000(2)       ; 1001: выбор канала КРК 2; М2 := 70000
к э32 0, сда 130                ; 1002: состояние каналов
к нтж 1100, пе 1040             ; 1003: должно быть 02000
к сч 1101, э32 70100            ; 1004: запись 777777 в ячейку 100
к э32 100, сда 130              ; 1005
к нтж 1102, пе 1041             ; 1006: записано 16 разрядов
к э32 7777(2), сда 130          ; 1007: чтение 77777 через модификатор
к нтж 1103, пе 1042             ; 1010: это чтение, а не запись
к уиа 1(1), счи 1               ; 1011
к э32 70000, мода               ; 1012: выбор канала КРК 1
к э32 100, сда 130              ; 1013
к нтж 1103, пе 1043             ; 1014: у канала 1 своя память
к сч 1101, э32 0                ; 1015: чтение при ненулевой правой половине
к нтж 1104, пе 1044             ; 1016: правая половина очищена
к пб 1017, мода                 ; 1017: все хорошо
в 1040
к пб 1040, мода                 ; неверное состояние в ячейке 0
к пб 1041, мода                 ; запись не 16-разрядная
к пб 1042, мода                 ; чтение 77777 испортило память
к пб 1043, мода                 ; память каналов общая
к пб 1044, мода                 ; чтение не очистило правую половину
в 1100
с 0000000000002000
с 0000000000777777
с 0000000000177777
с 0
с 0000200000000000
